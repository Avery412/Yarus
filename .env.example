# Пример параметров локального PostgreSQL. Укажите собственный пароль отдельно.
YARUS_DB_HOST=localhost
YARUS_DB_PORT=5432
YARUS_DB_USERNAME=postgres
YARUS_DB_MAINTENANCE_DATABASE=postgres
# YARUS_DB_PASSWORD задайте в текущей сессии PowerShell, не записывайте пароль в этот файл.
YARUS_DB_DEVELOPMENT=yarus_development
YARUS_DB_TEST=yarus_test
YARUS_DB_PRODUCTION=yarus_production
